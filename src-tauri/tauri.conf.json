{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Poros",
  "version": "0.1.0",
  "identifier": "io.github.khaodius.poros",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Poros",
        "width": 1360,
        "height": 860,
        "minWidth": 900,
        "minHeight": 560,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: asset: http://asset.localhost; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "publisher": "khaodius",
    "homepage": "https://github.com/khaodius/poros",
    "license": "Apache-2.0",
    "shortDescription": "SFTP and rsync client",
    "longDescription": "Dual-pane SFTP client for Linux and Windows with OpenSSH and PuTTY key support.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "wix": {
        "upgradeCode": "e72f869c-e3b1-5624-bbc1-3466f84ff3af"
      },
      "nsis": {
        "installerHooks": "windows/installer-hooks.nsh"
      }
    }
  }
}
